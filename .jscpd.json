{
  "min-tokens": 70,
  "threshold": 5,
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "backend/src/**/*",
    "workers/src/**/*"
  ],
  "exclude": [
    "**/generated/**",
    "**/*.test.ts",
    "**/abis/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "format": ["typescript", "javascript"],
  "reporters": ["console"],
  "output": "./reports/jscpd"
}
