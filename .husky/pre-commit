# Phase 1: Build (source code TS compilation)
npm run build && npm run build -w aave-dashboard-backend || { echo "❌ pre-commit: build failed — fix TS errors before committing"; exit 1; }

# Phase 2: Test file type checking
npm run test:typecheck -w aave-dashboard-backend || { echo "❌ pre-commit: test typecheck failed — fix TS errors in test files before committing"; exit 1; }

# Phase 3: Auto-fixable config checks (bin-paths, globstar)
# Fixes are applied to working tree — lint-staged will stage them into the commit.
bash scripts/hook-autofix.sh pre-commit || { echo "❌ pre-commit: auto-fix failed — see errors above"; exit 1; }

# ── Large file guard: warn >=10MB, block >=100MB (git/GitHub hard limit) ──
_SIZE_SCAN=$(git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
  [ -f "$f" ] || continue
  bytes=$(wc -c < "$f" | tr -d ' ')
  if [ "$bytes" -ge 104857600 ]; then
    echo "BLOCK ${f} ($((bytes / 1048576))MB)"
  elif [ "$bytes" -ge 10485760 ]; then
    echo "WARN ${f} ($((bytes / 1048576))MB)"
  fi
done)
if echo "$_SIZE_SCAN" | grep -q '^BLOCK'; then
  echo "$_SIZE_SCAN" | grep '^BLOCK' | while IFS= read -r line; do echo "  $line"; done
  echo "❌ [pre-commit] BLOCKED: files >= 100MB cannot be committed (git/GitHub limit)."
  exit 1
fi
echo "$_SIZE_SCAN" | grep '^WARN' | while IFS= read -r line; do echo "⚠️  [pre-commit] large file: $line — confirm intentional"; done

# Phase 4: Prettier formatting (lint-staged auto-fixes and stages)
npx lint-staged
