bash scripts/hook-autofix.sh pre-push

# ── Security scan (#197 toolchain: osv-scanner + semgrep) ──
# Both gates BLOCKING as of 2026-09-06. Known-unfixable exceptions are
# allowlisted below (currently: elliptic GHSA-848j-6mx2-7j84, Medium, no
# upstream fix available). Remove the entry once a fixed version ships.
# scan:mcp (.mcp.json supply chain) stays manual: npm run scan:mcp
if command -v osv-scanner >/dev/null 2>&1; then
  _OSV_OUT=$(osv-scanner --lockfile package-lock.json 2>/dev/null)
  if [ $? -ne 0 ]; then
    echo "$_OSV_OUT" | grep -E "osv.dev|GHSA" | grep -v "GHSA-848j-6mx2-7j84" | while IFS= read -r line; do echo "  $line"; done
    _UNFIXED=$(echo "$_OSV_OUT" | grep -oE "GHSA-[a-z0-9-]+" | grep -v "GHSA-848j-6mx2-7j84" | head -1)
    if [ -n "$_UNFIXED" ]; then
      echo "❌ [pre-push] BLOCKED: fixable vulnerabilities in package-lock.json — run 'npm audit fix', then 'npm run scan:deps'"
      exit 1
    else
      echo "⚠️  [pre-push] osv-scanner: only allowlisted (unfixable) advisories present"
    fi
  fi
fi
if command -v semgrep >/dev/null 2>&1; then
  semgrep scan --config p/default --metrics=off --quiet --error src/ packages/ || {
    echo "❌ [pre-push] BLOCKED: semgrep findings in src/ packages/ — run 'npm run scan:code'"
    exit 1
  }
fi
