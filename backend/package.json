{
  "name": "aave-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API server for Aave APY Dashboard",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "bash scripts/dev-entry.sh",
    "dev:clean": "bash scripts/dev-clean.sh",
    "dev:reset": "npm run dev:clean && npm run dev",
    "dev:watch": "bash scripts/dev-entry.sh --watch",
    "dev:watch:reset": "npm run dev:clean && npm run dev:watch",
    "test": "tsx --test tests/*.test.ts",
    "test:api-fields": "RUN_API_FIELDS_TESTS=true tsx --test tests/apiFieldsVerification.test.ts",
    "prune": "ts-prune -i '.*aave-shared-config/index\\.d\\.ts' -i '.*aave-shared-contracts/index\\.d\\.ts' -i '.*aave-fetcher/index\\.d\\.ts' 2>&1 | grep -v '(used in module)' | grep '^src/' | (grep -q . && exit 1 || exit 0)"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.49.9",
    "@aave/contract-helpers": "^1.37.1",
    "@internal/aave-shared-config": "*",
    "@internal/aave-shared-contracts": "*",
    "@internal/aave-fetcher": "*",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.20.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ethers": "^5.8.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "ts-prune": "^0.10.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
