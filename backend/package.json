{
  "name": "aave-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API server for Aave APY Dashboard",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "npm run gen:schema-fp && npm run gen:openapi && tsc",
    "gen:openapi": "npx --no-install tsx scripts/generate-openapi.ts",
    "start": "node dist/server.js",
    "dev": "bash scripts/dev-entry.sh",
    "dev:clean": "bash scripts/dev-clean.sh",
    "dev:reset": "npm run dev",
    "dev:watch": "bash scripts/dev-entry.sh --watch",
    "dev:watch:reset": "npm run dev:watch",
    "test": "npx --no-install tsx --test tests/*.test.ts",
    "test:coverage": "npx --no-install c8 --include 'src/**' --check-coverage --lines 53 --statements 53 --functions 60 --branches 80 --reporter=text-summary npx --no-install tsx --test tests/*.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "profile:cpu": "node --prof dist/server.js",
    "profile:report": "f=$(ls -t isolate-*.log 2>/dev/null | head -1) && [ -n \"$f\" ] && node --prof-process \"$f\" > profiling-summary.txt && echo \"wrote profiling-summary.txt from $f\"",
    "gen:schema-fp": "npx --no-install tsx scripts/generate-schema-fp.ts",
    "test:api-fields": "RUN_API_FIELDS_TESTS=true npx --no-install tsx --test tests/apiFieldsVerification.test.ts",
    "prune": "ts-prune -i '\\.d\\.ts' 2>&1 | grep -v '(used in module)' | grep -v 'SEMRUSH_TO_GSC' | grep -v 'ForTests' | grep '^src/' | (grep -q . && exit 1 || exit 0)"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.57.1",
    "@aave/contract-helpers": "^1.37.1",
    "@internal/aave-fetcher": "1.0.0",
    "@internal/aave-rpc-infra": "1.0.0",
    "@internal/aave-shared-config": "1.0.0",
    "@internal/aave-shared-contracts": "1.0.0",
    "@sentry/node": "^10.74.0",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.20.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "ethers": "5.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "undici": "^7.28.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-json-schema-generator": "^2.9.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
