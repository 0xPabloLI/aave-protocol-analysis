  "dependencies": {
    "@aave/client": "^0.6.1",
    "@bgd-labs/aave-address-book": "^4.30.3",
    "node-fetch": "^3.3.2",
    "protobufjs": "^8.0.0",
    "puppeteer": "^21.11.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "aave",
    "defi",
    "typescript",
    "markets"
  ],
  "author": "",
