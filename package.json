{
  "name": "aave-markets-data",
  "version": "1.0.0",
  "description": "Fetch Aave market data using TypeScript SDK",
  "keywords": [
    "aave",
    "defi",
    "typescript",
    "markets"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "ci": "npm ci && npm run build && npm run prune && cd backend && npm ci && npm run build && npm run prune",
    "deploy": "./deploy.sh",
    "mcp:context7": "node .cursor/context7-server.js",
    "prune": "ts-prune 2>&1 | (grep -v '(used in module)' | grep -q . && exit 1 || exit 0)"
  },
  "dependencies": {
    "@aave/client": "^0.6.1",
    "@internal/merkl-shared": "file:packages/merkl-shared",
    "@bgd-labs/aave-address-book": "^4.30.3",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/puppeteer": "^5.4.7",
    "cheerio": "^1.1.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.35.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "axios": "^1.13.5",
    "h3": "^1.15.5",
    "hono": "^4.11.9",
    "preact": "^10.28.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.19.27",
    "ts-prune": "^0.10.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
