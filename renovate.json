{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "osvVulnerabilityAlerts": true,
  "baseBranchPatterns": ["railway"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "platformAutomerge": false,
  "postUpdateOptions": ["npmInstallTwice"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },
  "packageRules": [
    {
      "matchDepNames": ["@aave-dao/aave-address-book"],
      "labels": ["dependencies", "address-book-upgrade"]
    },
    {
      "matchDepNames": ["ethers"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pinDigest"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
